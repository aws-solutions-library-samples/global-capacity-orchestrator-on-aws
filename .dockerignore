# Exclude everything by default, then allowlist only what root-context builds
# need. Regional CDK service assets add per-image exclusions so CLI metadata and
# another service's Docker inputs do not invalidate unrelated image hashes.
*

# Allow the source packages and build config
!gco/
!cli/
!pyproject.toml
!requirements-lock.txt
!dockerfiles/
# The TLS certificate manager image builds from the repository root too, so
# its pip install can be constrained by requirements-lock.txt (see its image
# asset in gco/stacks/api_gateway_global_stack.py). The service images leave
# these files out of their own contexts with their CDK excludes.
!lambda/tls-certificate-manager/handler.py
!lambda/tls-certificate-manager/requirements.txt

# Re-exclude generated/cache dirs inside the allowed paths. The tests import
# the dockerfiles/ build helpers too, so their bytecode would otherwise change
# every service image's CDK asset hash between a working checkout and a clean
# clone of the same commit.
gco/**/__pycache__/
cli/**/__pycache__/
dockerfiles/**/__pycache__/
gco/**/*.pyc
cli/**/*.pyc
dockerfiles/**/*.pyc
gco/**/*.pyo
cli/**/*.pyo
dockerfiles/**/*.pyo

# gco/stacks/ is intentionally NOT excluded. Earlier versions dropped it
# from the container build context to keep service images slim and to
# stabilise the CDK asset fingerprint against CDK-only edits, but that
# also meant `gco stacks deploy-all` didn't work inside Dockerfile.dev —
# which is the canonical place to run CDK commands from. The extra ~20
# Python files cost negligible image size, and service containers never
# import anything under gco.stacks at runtime, so the tradeoff is
# worthwhile.
