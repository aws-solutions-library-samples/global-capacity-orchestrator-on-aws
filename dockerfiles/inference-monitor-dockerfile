# Inference Monitor Service
# Reconciliation controller that polls DynamoDB for desired inference
# endpoint state and creates/updates/deletes K8s resources accordingly.
#
# Two-stage distroless build: the pinned python slim builder installs the
# locked dependency set and applies Debian security patches, then
# dockerfiles/build_scratch_rootfs.py stages a minimal root filesystem
# (interpreter, site-packages, app tree, exact ELF closure, CA trust,
# zoneinfo, dpkg scanner metadata) that the FROM scratch runtime stage copies
# wholesale. The deployed image contains no shell, package manager, or
# coreutils. See the script's module docstring for the full rationale.
FROM python:3.14.6-slim AS builder

# Apply Debian security patches at build time. APT_SECURITY_EPOCH busts
# the CI layer cache so a freshly-published trixie-security patch isn't
# masked by a stale cached upgrade layer; bump the date when needed. The
# patched libraries are exactly what build_scratch_rootfs.py copies into
# the runtime rootfs, so this remains the mechanism that ships fresh
# glibc/OpenSSL fixes.
ARG APT_SECURITY_EPOCH=2026-08-18
RUN echo "apt security epoch ${APT_SECURITY_EPOCH}" \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install only this service's direct runtime roots. The roots live in the
# image-inference-monitor optional-dependency group; Python 3.14's tomllib
# emits a temporary requirements file so pyproject.toml remains the sole
# direct-pin source. requirements-lock.txt constrains the transitive graph.
#
# pip flags + bash retry loop guard against transient PyPI/CDN drops
# (see Dockerfile.dev for the rationale; same pattern across every
# image build in the repo).
COPY pyproject.toml requirements-lock.txt ./
RUN python -c 'import pathlib, tomllib; config = tomllib.loads(pathlib.Path("pyproject.toml").read_text(encoding="utf-8")); dependencies = config["project"]["optional-dependencies"]["image-inference-monitor"]; pathlib.Path("requirements-runtime.txt").write_text("-c requirements-lock.txt\n" + "\n".join(dependencies) + "\n", encoding="utf-8")' \
    && for attempt in 1 2 3; do \
        if pip install --no-cache-dir \
            --retries 10 --timeout 120 --resume-retries 5 \
            -r requirements-runtime.txt; then \
            break; \
        fi; \
        if [ "${attempt}" -eq 3 ]; then \
            echo "pip install failed after ${attempt} attempts" >&2; \
            exit 1; \
        fi; \
        echo "pip install attempt ${attempt} failed; retrying in 10s..."; \
        sleep 10; \
    done \
    && rm requirements-runtime.txt \
    && python -m pip uninstall -y pip

# Nothing installs packages at runtime, so pip is uninstalled above in the
# same layer that finishes using it — before the runtime rootfs is staged:
# installer tooling stays out of the deployed attack surface and out of the
# image scanners' findings feed. (3.14-slim ships no setuptools/wheel, and
# the lock declares no runtime dependency on either, so pip is the only
# installer present. The rootfs script also drops ensurepip's bundled wheel.)

# Keep source-only edits from invalidating the expensive dependency layer.
COPY gco/ ./gco/

# Precompile the application tree. The pod runs with
# readOnlyRootFilesystem, so import-time .pyc writes fail silently and
# every pod start would otherwise re-compile every module from source;
# compiling at build converts that recurring cost into a one-time one.
# (site-packages is already compiled by pip at install time. Health
# checking is owned by the kubelet exec probes in the deployment manifest —
# ["python", "-c", ...], which needs no shell; a Docker HEALTHCHECK would
# never be read by Kubernetes.)
RUN python -m compileall -q ./gco

# Assemble the minimal runtime rootfs under /rootfs. Fails the build loudly
# on any unresolved shared library, unattributed file, or missing trust
# anchor — closure gaps must never ship as crash-looping pods. Also probes
# which stdlib extensions the builder itself can import and writes that
# manifest next to runtime_smoke.py in /opt/build for the final stage's
# bind-mounted parity check.
COPY dockerfiles/build_scratch_rootfs.py dockerfiles/runtime_smoke.py /opt/build/
RUN python /opt/build/build_scratch_rootfs.py

# ---------------------------------------------------------------------------
# Runtime stage: distroless. Only the staged rootfs ships — no shell, no
# apt/dpkg tooling, no coreutils. The deployment's exec probes already use
# ["python", "-c", ...], which keeps working here.
FROM scratch

COPY --from=builder /rootfs/ /

# scratch provides no environment at all, so PATH is set explicitly — CMD
# and the kubelet exec probes resolve `python` through it. HOME matches the
# synthesized passwd entry for uid 1000 (no login machinery exists to derive
# it). PYTHONDONTWRITEBYTECODE documents that runtime bytecode writes are
# neither needed (everything is precompiled) nor possible (read-only root
# filesystem). PYTHONUNBUFFERED keeps log lines ordered and complete
# through container runtimes and crashes.
ENV PATH=/usr/local/bin:/usr/bin:/bin \
    HOME=/home/gco \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
ENV RECONCILE_INTERVAL_SECONDS=15
ENV INFERENCE_NAMESPACE=gco-inference

WORKDIR /app

# Switch to non-root user (synthesized in the rootfs /etc/passwd as uid 1000,
# matching the pod securityContext)
USER gco

# Build-time runtime smoke, exec form (no shell exists to RUN through).
# runtime_smoke.py imports every stdlib extension the builder could import —
# the set is derived into runtime_smoke_manifest.json by the rootfs script,
# so no module list is maintained by hand — plus the real service entry
# module, as the runtime user, and verifies NSS identity, CA trust anchors,
# and tzdata. A gap fails every build — including CDK deploys — instead of
# the pod. The bind mount exists only for this RUN (BuildKit — the default
# in Docker 23+, buildx, and finch), so the deployed image ships no build
# tooling; a delete in a later layer would merely hide it, layers being
# additive.
RUN --mount=type=bind,from=builder,source=/opt/build,target=/opt/build \
    ["python", "/opt/build/runtime_smoke.py", "gco.services.inference_monitor"]

# Run the inference monitor
CMD ["python", "-m", "gco.services.inference_monitor"]
