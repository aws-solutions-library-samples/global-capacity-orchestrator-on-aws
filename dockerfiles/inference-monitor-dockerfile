# Inference Monitor Service
# Reconciliation controller that polls DynamoDB for desired inference
# endpoint state and creates/updates/deletes K8s resources accordingly.
FROM python:3.14.6-slim

# Apply Debian security patches at build time. APT_SECURITY_EPOCH busts
# the CI layer cache so a freshly-published trixie-security patch isn't
# masked by a stale cached upgrade layer; bump the date when needed.
ARG APT_SECURITY_EPOCH=2026-06-12
RUN echo "apt security epoch ${APT_SECURITY_EPOCH}" \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r gco && useradd -r -g gco -d /app -s /sbin/nologin gco

WORKDIR /app

# Copy project metadata and install inference-monitor dependencies only
# Use the lockfile for reproducible transitive dependency versions,
# then install the project with inference-monitor extras without re-resolving.
#
# pip flags + bash retry loop guard against transient PyPI/CDN drops
# (see Dockerfile.dev for the rationale; same pattern across every
# image build in the repo).
COPY requirements-lock.txt ./
COPY pyproject.toml ./
COPY gco/ ./gco/
RUN for attempt in 1 2 3; do \
        pip install --no-cache-dir \
            --retries 10 --timeout 120 --resume-retries 5 \
            -r requirements-lock.txt && break; \
        echo "pip install attempt ${attempt} failed; retrying in 10s..."; \
        sleep 10; \
    done \
    && pip install --no-cache-dir --no-deps ".[inference-monitor]"

# Switch to non-root user
USER gco

# Set environment defaults
ENV PYTHONUNBUFFERED=1
ENV RECONCILE_INTERVAL_SECONDS=15
ENV INFERENCE_NAMESPACE=gco-inference

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "print('ok')" || exit 1

# Run the inference monitor
CMD ["python", "-m", "gco.services.inference_monitor"]