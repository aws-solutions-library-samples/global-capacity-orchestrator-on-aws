# Dockerfile for Manifest Processor Service
# Validates and applies Kubernetes manifests submitted via API Gateway.
# Enforces namespace restrictions, resource limits, and security policies.
# Runs as a Deployment in gco-system behind the ALB.
FROM python:3.14.6-slim

# Set working directory
WORKDIR /app

# Apply Debian security patches at build time, then install runtime deps.
# APT_SECURITY_EPOCH busts the CI layer cache so a freshly-published
# trixie-security patch isn't masked by a stale cached upgrade layer;
# bump the date when a new fix needs pulling.
ARG APT_SECURITY_EPOCH=2026-07-12
RUN echo "apt security epoch ${APT_SECURITY_EPOCH}" \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r gco && useradd -r -g gco -u 1000 gco

# Copy project metadata and install Python dependencies
# Use the lockfile for reproducible transitive dependency versions,
# then install the project itself without re-resolving.
#
# pip flags + bash retry loop guard against transient PyPI/CDN drops
# (see Dockerfile.dev for the rationale; same pattern across every
# image build in the repo).
COPY requirements-lock.txt ./
COPY pyproject.toml ./
COPY gco/ ./gco/
COPY cli/ ./cli/
RUN for attempt in 1 2 3; do \
        pip install --no-cache-dir \
            --retries 10 --timeout 120 --resume-retries 5 \
            -r requirements-lock.txt && break; \
        echo "pip install attempt ${attempt} failed; retrying in 10s..."; \
        sleep 10; \
    done \
    && pip install --no-cache-dir --no-deps .

# Set Python path
ENV PYTHONPATH=/app

# Create tmp directory for non-root user
RUN mkdir -p /tmp && chown gco:gco /tmp

# Switch to non-root user
USER gco

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

# Run the application
CMD ["python", "-m", "gco.services.manifest_api"]