# Dockerfile for Queue Processor Service
#
# Consumes Kubernetes manifests from the regional SQS job queue and applies
# them to the cluster. Runs as a KEDA ScaledJob pod — one pod per SQS message.
#
# This image is built by CDK during `gco stacks deploy` and pushed to ECR.
# The KEDA ScaledJob manifest (post-helm-sqs-consumer.yaml) references the image URI.
#
# To disable the built-in queue processor, set queue_processor.enabled = false
# in cdk.json. See docs/CUSTOMIZATION.md for details.
FROM python:3.14.6-slim

# Set working directory
WORKDIR /app

# Apply Debian security patches at build time.
# APT_SECURITY_EPOCH busts the CI layer cache so a freshly-published
# trixie-security patch isn't masked by a stale cached upgrade layer;
# bump the date when a new fix needs pulling.
#
# No OS packages are installed beyond the patched base.
ARG APT_SECURITY_EPOCH=2026-07-30
RUN echo "apt security epoch ${APT_SECURITY_EPOCH}" \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r gco && useradd -r -g gco -u 1000 gco

# Install only this service's direct runtime roots. The roots live in the
# image-queue-processor optional-dependency group; Python 3.14's tomllib emits
# a temporary requirements file so pyproject.toml remains the sole direct-pin
# source. requirements-lock.txt constrains the complete transitive graph.
#
# pip flags + bash retry loop guard against transient PyPI/CDN drops
# (see Dockerfile.dev for the rationale; same pattern across every
# image build in the repo).
COPY pyproject.toml requirements-lock.txt ./
RUN python -c 'import pathlib, tomllib; config = tomllib.loads(pathlib.Path("pyproject.toml").read_text(encoding="utf-8")); dependencies = config["project"]["optional-dependencies"]["image-queue-processor"]; pathlib.Path("requirements-runtime.txt").write_text("-c requirements-lock.txt\n" + "\n".join(dependencies) + "\n", encoding="utf-8")' \
    && for attempt in 1 2 3; do \
        if pip install --no-cache-dir \
            --retries 10 --timeout 120 --resume-retries 5 \
            -r requirements-runtime.txt; then \
            break; \
        fi; \
        if [ "${attempt}" -eq 3 ]; then \
            echo "pip install failed after ${attempt} attempts" >&2; \
            exit 1; \
        fi; \
        echo "pip install attempt ${attempt} failed; retrying in 10s..."; \
        sleep 10; \
    done \
    && rm requirements-runtime.txt \
    && python -m pip uninstall -y pip

# Nothing installs packages at runtime, so pip is uninstalled above in the
# same layer that finishes using it: installer tooling stays out of the
# deployed attack surface and out of the image scanners' findings feed.
# (3.14-slim ships no setuptools/wheel, and the lock declares no runtime
# dependency on either, so pip is the only installer present.)

# Keep source-only edits from invalidating the expensive dependency layer.
COPY gco/ ./gco/

# Precompile the application tree. This pod runs with
# readOnlyRootFilesystem AND is a KEDA ScaledJob — one pod per SQS message —
# so without build-time compilation every message paid a full from-source
# recompile of the tree before any work started. (site-packages is already
# compiled by pip at install time.)
RUN python -m compileall -q ./gco

# PYTHONDONTWRITEBYTECODE documents that runtime bytecode writes are
# neither needed (everything is precompiled) nor possible (read-only root
# filesystem). PYTHONUNBUFFERED keeps log lines ordered and complete
# through container runtimes and crashes.
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Switch to non-root user
USER gco

# Run the queue processor
CMD ["python", "-m", "gco.services.queue_processor"]
