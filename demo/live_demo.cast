[1.046,"o","\r\n\u001b[35m\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b(B\u001b[m\r\n\u001b[35m\u001b[1m  [3]  VOLCANO — Gang Scheduling for Distributed Training\u001b(B\u001b[m\r\n\u001b[35m\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b(B\u001b[m\r\n\r\n"]
[0.001,"o","  \u001b[2mVolcano is a Kubernetes-native batch scheduler built for AI/ML.\u001b(B\u001b[m\r\n  \u001b[2mIts killer feature: gang scheduling — all pods in a distributed\u001b(B\u001b[m\r\n  \u001b[2mtraining job start together, or none of them start at all.\u001b(B\u001b[m\r\n"]
[0.0,"o","  \u001b[2mThis prevents deadlocks where half the workers are waiting forever.\u001b(B\u001b[m\r\n\r\n"]
[0.0,"o","  \u001b[33m\u001b[1m▸ Submitting a Volcano gang-scheduled job (1 master + 2 workers)\u001b(B\u001b[m\r\n\r\n"]
[0.0,"o","  \u001b[35m$ \u001b[37m\u001b[1mgco jobs submit-direct examples/volcano-gang-job.yaml -r us-east-1 -n gco-jobs\u001b(B\u001b[m\r\n  \u001b[2m────────────────────────────────────────────────────────────\u001b(B\u001b[m\r\n"]
