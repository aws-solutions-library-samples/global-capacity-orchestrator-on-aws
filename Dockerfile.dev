# GCO Development Container
# Use this container to run CDK and CLI commands with all dependencies pre-installed
#
# Multi-arch: builds natively on linux/amd64 (CI on x86_64 GitHub runners,
# Docker Desktop on Intel Macs / Linux) and linux/arm64 (Apple Silicon
# Macs running Docker Desktop, Finch, Colima, or any arm64 Linux host).
# kubectl, the AWS CLI v2, and the Docker static client all publish both
# arch builds; we pick the right one via BuildKit's $TARGETARCH. The
# Docker Buildx plugin is installed alongside the client so the multi-arch
# image mirror and the linux/amd64 asset builds that `gco stacks deploy-all`
# performs work out of the box on Apple Silicon (arm64) as well as x86_64.
#
# Build:
#   docker build -f Dockerfile.dev -t gco-dev .
#
# To cross-build, pass --platform explicitly:
#   docker build --platform linux/amd64 -f Dockerfile.dev -t gco-dev .
#
# Run (interactive):
#   docker run -it --rm \
#     -v ~/.aws:/root/.aws:ro \
#     -v $(pwd):/workspace \
#     -w /workspace \
#     gco-dev
#
# Run a command:
#   docker run --rm \
#     -v ~/.aws:/root/.aws:ro \
#     -v $(pwd):/workspace \
#     -w /workspace \
#     gco-dev gco stacks list
#
# Run with Docker-in-Docker for `gco stacks deploy-all`:
#   `cdk deploy` (which `gco stacks deploy-all` invokes) bundles Lambda
#   assets by running Docker during synth. The dev container does not ship
#   a Docker daemon, so we pass through the host's daemon socket:
#
#   docker run --rm -it \
#     -v ~/.aws:/root/.aws:ro \
#     -v $(pwd):/workspace \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -w /workspace \
#     gco-dev gco stacks deploy-all -y
#
#   The Docker CLI is installed inside the image (see below) and the
#   `/var/run/docker.sock` bind mount hands it a transport to the host
#   daemon. This is "Docker out of Docker" / host-socket pass-through —
#   NOT true Docker-in-Docker (which would run a daemon inside the
#   container). We avoid `--privileged` because socket pass-through does
#   not need it.
#
#   Security note: anyone with access to the container gets root-equivalent
#   access to the host Docker daemon via the mounted socket. Keep the
#   container on a trusted host and avoid mounting the socket when running
#   untrusted code.
#
#   Host compatibility (scripts/setup-dev-alias.sh finds and checks the
#   socket for you; these are the paths it tries). A bind-mount source is a
#   path as the daemon sees it, inside the VM for a VM-based runtime:
#     - Linux Docker, Docker Desktop, Colima and OrbStack:
#         -v /var/run/docker.sock:/var/run/docker.sock
#       (the VM-based ones serve that path inside their VMs).
#     - Rootless Docker, or a daemon on its own socket: the socket of
#       DOCKER_HOST or the current context, e.g.
#         -v "$XDG_RUNTIME_DIR/docker.sock:/var/run/docker.sock"
#     - Podman: the path `podman info --format '{{.Host.RemoteSocket.Path}}'`
#       prints (inside the machine on macOS and Windows), with
#         -e DOCKER_BUILDKIT=0 --security-opt label=disable
#       Podman's Docker API has no BuildKit, so the Docker CLI's classic
#       `docker build` hands each build to Podman, which stores the image in
#       its own store; label=disable lets an SELinux-confined container
#       (Podman machines, Fedora) use the socket.
#     - Finch (v1.8.0 and later): finch-daemon's /run/finch.sock in the
#       Finch VM (on the host on Linux), with -e DOCKER_BUILDKIT=0 for the
#       same reason as Podman.

# checkov:skip=CKV_DOCKER_2:An interactive contributor shell has no service to
# health-check.
# checkov:skip=CKV_DOCKER_3:Contributors bind-mount their own checkout and AWS
# credentials and run host-side gco/cdk/kubectl commands inside this image, so it
# has to run as the invoking host user. It is never deployed.
FROM python:3.14.9-slim

# Multi-arch build args. BuildKit auto-populates TARGETARCH with the build
# platform's Go-style arch name (`amd64` / `arm64`). We additionally derive
# the GNU/Linux arch tag (`x86_64` / `aarch64`) for tools whose download
# URLs use that convention (AWS CLI v2, Docker static binaries).
#
# Building natively for the host arch is the default (`finch build .` on
# Apple Silicon → arm64; CI on x86_64 runners → amd64). To cross-build,
# pass `--platform linux/amd64` or `--platform linux/arm64`.
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
        amd64)  echo "x86_64"  > /tmp/gnu_arch ;; \
        arm64)  echo "aarch64" > /tmp/gnu_arch ;; \
        *)      echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac

# Install system dependencies and apply Debian security patches.
# APT_SECURITY_EPOCH busts the CI layer cache so a freshly-published
# trixie-security patch isn't masked by a stale cached upgrade layer;
# bump the date when a new fix needs pulling.
ARG APT_SECURITY_EPOCH=2026-11-23
RUN echo "apt security epoch ${APT_SECURITY_EPOCH}" \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        unzip \
        groff \
        less \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install Node.js (for CDK) — pinned to an exact release, downloaded as
# the official nodejs.org dist tarball and verified against the SHA-256
# published in that release's SHASUMS256.txt.
#
# This deliberately does NOT use the NodeSource apt repository. Their
# setup script was the only third-party-intermediated `curl | bash`
# install left in this image, it pinned nothing beyond the major, and a
# NodeSource CDN 403 outage (2026-07-27) broke every dev-container CI
# job while the official dist endpoint stayed up. The tarball install
# matches how every binary tool below is provisioned: a pinned direct
# download from the vendor's canonical distribution point, verified
# against a committed SHA-256, which the NodeSource path could never offer.
# (npm and the CDK CLI come from the npm registry at exact versions.)
#
# Bump procedure (keep the three ARGs in lockstep):
#   1. Pick the release from https://nodejs.org/dist/index.json
#      (deps-scan reports drift against the newest active-LTS release).
#   2. Copy both hashes from
#      https://nodejs.org/dist/<NODE_VERSION>/SHASUMS256.txt
#      for node-<NODE_VERSION>-linux-{x64,arm64}.tar.gz.
# Node's tarballs use x64/arm64 arch tags; amd64 maps to x64 below.
ARG NODE_VERSION=v24.22.2
ARG NODE_SHA256_AMD64=361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9
ARG NODE_SHA256_ARM64=95c264150aceb7f3437a29fd6984924f5f8d1511ea3cbd6c508b83f6c555dae2
RUN case "${TARGETARCH}" in \
        amd64)  NODE_ARCH="x64";   NODE_SHA256="${NODE_SHA256_AMD64}" ;; \
        arm64)  NODE_ARCH="arm64"; NODE_SHA256="${NODE_SHA256_ARM64}" ;; \
        *)      echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz" \
      -o /tmp/node.tar.gz \
    && echo "${NODE_SHA256}  /tmp/node.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 --no-same-owner \
    && rm /tmp/node.tar.gz \
    && node --version

# Pin npm to a specific patch.
#
# The npm bundled inside the Node dist tarball is fixed per Node
# release, but it lags npm's own release line and would silently
# change whenever NODE_VERSION is bumped. We pin it the same way we
# pin every other contributor-facing tool below (CDK CLI, kubectl,
# AWS CLI v2, Docker CLI) so rebuilds are reproducible and
# Dependency-scan can flag drift cleanly.
#
# Bump in lockstep with the deps-scan report; the value flows through
# as ``NPM_VERSION`` in the Dockerfile.dev pins section.
ARG NPM_VERSION=12.2.1
RUN npm install -g "npm@${NPM_VERSION}" \
    && npm --version

# Install AWS CDK CLI — pinned so the dev container and CI agree on the
# synth output and bootstrap qualifier semantics. The CDK CLI
# (``aws-cdk``) and the CDK library (``aws-cdk-lib``) are versioned
# independently — do not assume the two version strings match. Bump the
# CLI in lockstep with `npm view aws-cdk version` when rebuilding.
ARG CDK_VERSION=2.1147.0
RUN npm install -g "aws-cdk@${CDK_VERSION}" \
    && cdk --version

# Install kubectl — pinned to the EKS cluster's minor line (see
# ``cdk.json::kubernetes_version``). The kubectl + apiserver skew policy
# allows ±1 minor, so this pin can lag or lead the cluster by one.
# kubectl publishes both linux/amd64 and linux/arm64 binaries, so we
# pass ${TARGETARCH} straight through.
#
# The per-architecture checksums are literal, non-overridable trust anchors
# copied from the release's published
# https://dl.k8s.io/release/<version>/bin/linux/<arch>/kubectl.sha256 files.
# Overriding KUBECTL_VERSION alone fails closed until they are updated too.
ARG KUBECTL_VERSION=v1.37.2
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
        amd64) KUBECTL_SHA256="c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4" ;; \
        arm64) KUBECTL_SHA256="fcc16f63186659d9722014b7e02d5fdd2d4e669cb8c0ab66365d7d3b8ba03509" ;; \
        *)     echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      -o /tmp/kubectl \
    && echo "${KUBECTL_SHA256}  /tmp/kubectl" | sha256sum -c - \
    && install -m 0755 /tmp/kubectl /usr/local/bin/kubectl \
    && rm -f /tmp/kubectl \
    && kubectl version --client=true

# Install AWS CLI v2 — pinned to a specific release so reproducibility is
# preserved across rebuilds. Bump when a new feature or bugfix is needed
# (see https://github.com/aws/aws-cli/blob/v2/CHANGELOG.rst).
# AWS CLI v2 uses GNU arch tags (x86_64 / aarch64) in the install URL.
#
# The per-architecture checksums are literal, non-overridable trust anchors,
# recorded after each zip's PGP signature (<zip>.sig) verified against the
# AWS CLI Team key, fingerprint FB5D B77F D5C1 18B8 0511 ADA8 A631 0ACC
# 4672 475C, published in the AWS CLI install guide. To bump: download both
# zips and their .sig files, `gpg --verify` each, then copy each zip's
# SHA-256 here. Overriding AWSCLI_VERSION alone fails closed.
ARG AWSCLI_VERSION=2.39.3
RUN case "${TARGETARCH}" in \
        amd64) AWSCLI_SHA256="14cb35809ad7547dd3c69fa9899a3975fbd850b6a6791f3fe264856490cd9a63" ;; \
        arm64) AWSCLI_SHA256="f6eb845fbacb11bee87de3f5fbe8043773cbe89d0414607b44b71e216eb9226b" ;; \
        *)     echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && GNU_ARCH=$(cat /tmp/gnu_arch) \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${GNU_ARCH}-${AWSCLI_VERSION}.zip" \
      -o /tmp/awscliv2.zip \
    && echo "${AWSCLI_SHA256}  /tmp/awscliv2.zip" | sha256sum -c - \
    && unzip /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws \
    && aws --version

# Install the AWS Session Manager plugin. `gco cluster tunnel --via-ssm`,
# `gco monitoring open --via-ssm` and the other private-endpoint tunnels run
# `aws ssm start-session`, which hands the session to this binary; without it
# every tunnel fails before it starts. Pinned with per-arch SHA-256s taken from
# the published .deb packages (aws/session-manager-plugin release notes:
# https://github.com/aws/session-manager-plugin/releases). Bump the version and
# both checksums together.
ARG SESSION_MANAGER_PLUGIN_VERSION=1.2.896.0
ARG SESSION_MANAGER_PLUGIN_SHA256_AMD64=53f51fcc67314a4bf85888a38a3967cd41f8d0f28a60a9469a63acf935ba713e
ARG SESSION_MANAGER_PLUGIN_SHA256_ARM64=914eeca87b18b55356c58be197080f73742b3ca60d3823f0a45670dc9056aa9c
RUN case "${TARGETARCH}" in \
        amd64)  SMP_ARCH="ubuntu_64bit"; SMP_SHA256="${SESSION_MANAGER_PLUGIN_SHA256_AMD64}" ;; \
        arm64)  SMP_ARCH="ubuntu_arm64"; SMP_SHA256="${SESSION_MANAGER_PLUGIN_SHA256_ARM64}" ;; \
        *)      echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://s3.amazonaws.com/session-manager-downloads/plugin/${SESSION_MANAGER_PLUGIN_VERSION}/${SMP_ARCH}/session-manager-plugin.deb" \
      -o /tmp/session-manager-plugin.deb \
    && echo "${SMP_SHA256}  /tmp/session-manager-plugin.deb" | sha256sum -c - \
    && dpkg -i /tmp/session-manager-plugin.deb \
    && rm -f /tmp/session-manager-plugin.deb \
    && session-manager-plugin --version

# Install Docker CLI (client only — no daemon).
#
# `cdk deploy` shells out to Docker for Lambda asset bundling. The dev
# container talks to the host Docker daemon through the bind-mounted
# socket documented in the header, so only the client binary is needed
# here. Pinned to a specific version to keep the image reproducible —
# bump intentionally when testing against a new Docker release. Docker
# static binaries also use GNU arch tags (x86_64 / aarch64) in the URL.
# Latest stable at pin time:
#   https://download.docker.com/linux/static/stable/x86_64/
#   https://download.docker.com/linux/static/stable/aarch64/
#
# download.docker.com publishes no checksums for these archives, so the
# per-architecture SHA-256s were computed from the downloaded archives at
# pin time (each archive's MD5 matched its object ETag) and are literal,
# non-overridable trust anchors: overriding DOCKER_VERSION alone fails
# closed until they are updated too.
ARG DOCKER_VERSION=29.9.2
RUN case "${TARGETARCH}" in \
        amd64) DOCKER_SHA256="9ac225999fd5e863f7694c728ef23d480616b1e5639328fa309befd4243d69eb" ;; \
        arm64) DOCKER_SHA256="873b3e0207857c3b2f28392fb922f3ea6efe37620c16d4d4aaf2fef409c90b73" ;; \
        *)     echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && GNU_ARCH=$(cat /tmp/gnu_arch) \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${GNU_ARCH}/docker-${DOCKER_VERSION}.tgz" \
      -o /tmp/docker.tgz \
    && echo "${DOCKER_SHA256}  /tmp/docker.tgz" | sha256sum -c - \
    && tar -xzf /tmp/docker.tgz -C /tmp \
    && mv /tmp/docker/docker /usr/local/bin/ \
    && rm -rf /tmp/docker /tmp/docker.tgz /tmp/gnu_arch \
    && docker --version

# Install the Docker Buildx CLI plugin.
#
# `gco stacks deploy-all` needs a multi-arch image-copy tool for two
# steps, and on an arm64 host (Apple Silicon) both fail without Buildx:
#   1. The Volcano ECR image mirror — cli/_image_mirror.py prefers
#      `docker buildx imagetools create` (a registry-to-registry copy
#      that preserves the full multi-arch manifest list). Without a
#      multi-arch copy method it aborts before CloudFormation with
#      "No multi-arch image-copy method available".
#   2. The linux/amd64 Lambda/service asset images that CDK bundles —
#      the legacy builder cannot cross-build, failing with "image ...
#      does not provide the specified platform (linux/amd64)".
# The Docker static tarball above ships only the client binary (no
# cli-plugins/), so the plugin is installed separately here. Buildx
# publishes per-arch release binaries selected by ${TARGETARCH}; the
# plugin lives in a system cli-plugins path so the root user's docker
# CLI discovers it. Pinned for reproducibility — bump in lockstep with
# the deps-scan report.
#
# Keep the per-architecture checksums as literal, non-overridable trust
# anchors from the release's checksums.txt. Overriding BUILDX_VERSION alone
# must fail closed until these reviewed hashes are updated too.
# v0.38.2 links containerd v2.4.2, the fix for CVE-2026-95839 (v0.38.1
# linked v2.4.1).
# https://github.com/docker/buildx/releases/tag/v0.38.2
ARG BUILDX_VERSION=v0.38.2
RUN case "${TARGETARCH}" in \
        amd64) BUILDX_SHA256="7992ec09413b80ff57ba4e081f56fc833d7bac1d5e71143c6c809e7e6065f6d6" ;; \
        arm64) BUILDX_SHA256="46c0f334772de3cb0b341cc415caf7339fb5cfc8b8438ebcb5a10e7f23800d36" ;; \
        *)     echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/buildx/releases/download/${BUILDX_VERSION}/buildx-${BUILDX_VERSION}.linux-${TARGETARCH}" \
      -o /usr/local/lib/docker/cli-plugins/docker-buildx \
    && echo "${BUILDX_SHA256}  /usr/local/lib/docker/cli-plugins/docker-buildx" | sha256sum -c - \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx \
    && docker buildx version

# Install uv (and its uvx runner) — pinned to an exact release, downloaded as
# the official GitHub release tarball and verified against the SHA-256 the
# release publishes per artifact.
#
# `gco autopilot` launches several companion MCP servers through `uvx`
# (aws-docs, aws-pricing, eks, ddg-search, shell), so a dev-container
# autopilot session needs uv on PATH. Same provisioning discipline as every
# binary tool above: pinned direct vendor download + checksum. Bump procedure
# (keep the three ARGs in lockstep, hashes from the per-artifact *.sha256
# files on https://github.com/astral-sh/uv/releases):
ARG UV_VERSION=0.13.6
ARG UV_SHA256_AMD64=f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645
ARG UV_SHA256_ARM64=229e194255c7958d86d56e8790d969a6f74736592133f0dfd0076f754c642c1d
RUN case "${TARGETARCH}" in \
        amd64)  UV_TARGET="x86_64-unknown-linux-gnu";  UV_SHA256="${UV_SHA256_AMD64}" ;; \
        arm64)  UV_TARGET="aarch64-unknown-linux-gnu"; UV_SHA256="${UV_SHA256_ARM64}" ;; \
        *)      echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${UV_TARGET}.tar.gz" \
      -o /tmp/uv.tar.gz \
    && echo "${UV_SHA256}  /tmp/uv.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/uv.tar.gz -C /usr/local/bin --strip-components=1 \
    && rm /tmp/uv.tar.gz \
    && uv --version \
    && uvx --version

# Runtime npm prefix for tools installed *inside* a running container —
# notably the pinned Claude Code, Codex, or OpenCode release that
# `gco autopilot` installs on first use. Every image-baked npm global above
# (npm itself, the CDK CLI) was already installed under /usr/local before this
# line, so those stay in the image; this prefix only affects `npm install -g`
# at runtime. The setup-dev-alias.sh `gco` function mounts a named volume
# here, so every Autopilot engine install survives the `--rm` container
# lifecycle instead of re-downloading on every launch. OpenCode's session
# database lives under /root/.local/share/opencode; the same function mounts a
# second named volume there so --continue/--resume also survive.
ENV NPM_CONFIG_PREFIX=/root/.npm-global \
    PATH="/root/.npm-global/bin:${PATH}"
RUN mkdir -p /root/.npm-global/bin /root/.local/share/opencode

# Marks the CLI as running inside this image. Toolchain pin errors (the npm
# the inference streaming Lambda packages with, for example) then tell the
# user to rebuild the image with scripts/setup-dev-alias.sh instead of
# installing the tool on the host, which never reaches the container. Images
# built before this marker are recognized by the NPM_CONFIG_PREFIX above;
# cli/stacks.py reads both, and tests/test_stacks_extended.py pins them here.
ENV GCO_DEV_CONTAINER=1

# Set working directory
WORKDIR /workspace

# Copy project metadata first for better caching
COPY pyproject.toml requirements-lock.txt ./
COPY gco/_version.py ./gco/_version.py

# Install Python dependencies, the transitive graph constrained by the
# committed lock (as the service images and CI do), so two builds of one
# commit get the same packages instead of whatever PyPI serves that day.
#
# PyPI / CDN connections occasionally drop mid-download — most often
# during large wheels like ``pydantic-monty`` or ``aws-cdk-lib`` — and
# the build then fails with ``IncompleteRead``. To make rebuilds
# deterministic in CI:
#   - ``--retries 10`` raises pip's per-connection retry budget from
#     the default of 5.
#   - ``--timeout 120`` widens the socket timeout from the default 15s.
#   - ``--resume-retries 5`` (pip 24.1+) tells pip to resume partial
#     downloads instead of restarting them from byte 0.
#   - The shell-level ``for`` loop around the call provides a final
#     belt-and-suspenders retry if all the above still hits an
#     unrecoverable network blip; pip is idempotent under re-run.
RUN for attempt in 1 2 3; do \
        if pip install --no-cache-dir \
            --retries 10 --timeout 120 --resume-retries 5 \
            -c requirements-lock.txt -e ".[dev,mcp]"; then \
            break; \
        fi; \
        if [ "${attempt}" -eq 3 ]; then \
            echo "pip install failed after ${attempt} attempts" >&2; \
            exit 1; \
        fi; \
        echo "pip install attempt ${attempt} failed; retrying in 10s..."; \
        sleep 10; \
    done

# Copy the rest of the project
COPY . .

# Install the CLI in editable mode
RUN pip install --no-cache-dir -c requirements-lock.txt -e .

# Default command
CMD ["/bin/bash"]
